{
  "expo": {
    "name": "doctor-twin-staff",
    "slug": "doctor-twin-staff",
    "owner": "solimancare-1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/image/appIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/image/splashImage.png",
      "resizeMode": "contain",
      "backgroundColor": "#CFEFDC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solimancare.staff",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) access to your camera to take a staff profile picture.",
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library to upload and attach images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/image/appIcon.png",
        "backgroundColor": "#111747"
      },
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.solimancare.staff",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/image/appIcon.png",
          "color": "#ffffff"
        }
      ],
      "expo-secure-store",
      "expo-speech-recognition",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos to set a staff profile picture.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take a staff profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-speech-recognition"
    ],
    "extra": {
      "eas": {
        "projectId": "5b53e873-544a-4e0b-aa76-e308fdb3ccb6"
      }
    }
  }
}