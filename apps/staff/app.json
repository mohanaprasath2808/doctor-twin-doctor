{
  "expo": {
    "name": "doctor-twin-staff",
    "slug": "doctor-twin-staff",
    "owner": "solimancare-1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/image/appIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/image/splashImage.png",
      "resizeMode": "contain",
      "backgroundColor": "#CFEFDC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solimancare.staff",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photo library to upload and attach images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/image/appIcon.png",
        "backgroundColor": "#111747"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.solimancare.staff",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-speech-recognition"
    ],
    "extra": {
      "eas": {
        "projectId": "5b53e873-544a-4e0b-aa76-e308fdb3ccb6"
      }
    }
  }
}
